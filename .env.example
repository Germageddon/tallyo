# --- Storage ---
DB_PATH=./data/tallyo.sqlite

# --- Defaults for new users ---
DEFAULT_CURRENCY=USD
DEFAULT_TZ=UTC

# --- Telegram ---
# TELEGRAM_BOT_TOKEN=          # set to run on Telegram; unset = local CLI

# --- Parser ---
PARSER_MODE=auto              # auto (rules first, AI on miss) | rules | llm

# Optional AI fallback for messy phrasing the rules parser can't handle.
# Easiest free option: Groq (console.groq.com → free API key), OpenAI-compatible.
# GROQ_API_KEY=
# OPENAI_API_KEY=             # ...or OpenAI
# LLM_MODEL=                  # override the model. Groq default: llama-3.3-70b-versatile
                              # (llama-3.1-8b-instant is cheaper with a bigger free tier)

# --- Access control (for a public bot) ---
# ACCESS_MODE=allowlist        # allowlist (default, private) | open (anyone can use it)
# OWNER_ID=                    # your Telegram numeric id (bypasses the allowlist)
# ALLOWLIST=                   # comma-separated approved Telegram ids
# RATE_LIMIT_PER_MIN=20        # per-user message rate limit
# DAILY_MSG_QUOTA=1000         # per-user daily message cap
# MAX_INPUT_CHARS=500          # reject overly long messages
