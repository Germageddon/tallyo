# Storage
DB_PATH=./data/tally.sqlite

# Defaults for new users
DEFAULT_CURRENCY=USD
DEFAULT_TZ=UTC

# Parser: rules | llm | auto  (auto = rules first, LLM only when unsure)
PARSER_MODE=auto

# TELEGRAM_BOT_TOKEN=   # set to run on Telegram; unset = local CLI

# Optional LLM fallback (for messy phrasing the rules parser can't handle).
# Easiest free option: Groq (console.groq.com → free API key), OpenAI-compatible.
# GROQ_API_KEY=
# ...or OpenAI:
# OPENAI_API_KEY=
# LLM_MODEL=            # override the model (default: llama-3.3-70b-versatile on Groq)
