# Storage
DB_PATH=./data/tally.sqlite

# Defaults for new users
DEFAULT_CURRENCY=USD
DEFAULT_TZ=UTC

# Parser: rules | llm | auto  (auto = rules first, LLM only when unsure)
PARSER_MODE=auto

